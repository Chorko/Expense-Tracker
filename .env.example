# Copy to .env.local and fill in. Both values are under
# Supabase dashboard → Project Settings → API keys.
# Only NEXT_PUBLIC_* vars reach the browser; keep real secret keys out of here.

# Your project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...). This is the new key name.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy fallback — only set this if your project still uses the old anon key
# and has not issued a publishable key yet. The app accepts either.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Edge Functions only (set as Supabase function secrets, NOT here) ─────────
# These are listed for reference. Set them with `supabase secrets set` or in the
# dashboard; never put real secret keys in a committed file.
#   RESEND_API_KEY=re_...
#   RESEND_FROM_EMAIL=Ledger <you@yourdomain.com>
#   APP_URL=https://your-app-url
#   SUPABASE_SERVICE_ROLE_KEY / SUPABASE_SECRET_KEYS are injected by the platform
